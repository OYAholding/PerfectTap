# PerfectTap — Fastlane lanes (App Store Connect API key auth).
#
# Credentials never live in this repo. They are read from a local env file
# (default ~/.config/perfecttap/apple/asc.env, override with PT_ASC_ENV):
#   ASC_KEY_ID=...        ASC_ISSUER_ID=...
#   ASC_KEY_PATH=$HOME/.config/perfecttap/apple/AuthKey_<KEY_ID>.p8
#
# Safety rules enforced here:
#   * Every lane is pinned to the PerfectTap app (App ID / bundle ID below) and
#     refuses to run if App Store Connect returns anything else.
#   * `asc_check`, `metadata_pull` and `build` never write to App Store Connect.
#   * `beta` and `metadata_push` write to App Store Connect and require
#     PT_CONFIRM=yes. Neither one submits for App Review, distributes to
#     external testers, or releases anything.

require "json"
require "net/http"

PT_APP_ID      = "6760975737"
PT_BUNDLE_ID   = "com.perfecttap.app"
PT_TEAM_ID     = "K88C7DPG4C"
PT_PROJECT     = File.expand_path("../ios/PerfectTap/PerfectTap.xcodeproj", __dir__)
PT_PROJECT_DIR = File.expand_path("../ios/PerfectTap", __dir__)
PT_SCHEME      = "PerfectTap"
PT_OUTPUT_DIR  = File.expand_path("../build/fastlane", __dir__)
PT_METADATA    = File.expand_path("metadata", __dir__)

default_platform(:ios)

# Loads KEY=VALUE pairs from the local, git-ignored env file. Values are kept
# in ENV only and never echoed.
def pt_load_asc_env!
  path = File.expand_path(ENV["PT_ASC_ENV"] || "~/.config/perfecttap/apple/asc.env")
  UI.user_error!("Missing #{path} (see fastlane/README.he.md)") unless File.exist?(path)
  File.readlines(path).each do |line|
    next if line.strip.empty? || line.strip.start_with?("#")
    key, value = line.strip.split("=", 2)
    ENV[key] ||= value.to_s.gsub("$HOME", Dir.home).gsub(/\A["']|["']\z/, "")
  end
  %w[ASC_KEY_ID ASC_ISSUER_ID ASC_KEY_PATH].each do |k|
    UI.user_error!("#{k} is not set in #{path}") if ENV[k].to_s.empty?
  end
  key_path = File.expand_path(ENV["ASC_KEY_PATH"])
  UI.user_error!("Private key not found at the configured ASC_KEY_PATH") unless File.exist?(key_path)
  repo_root = File.expand_path("..", __dir__)
  UI.user_error!("Refusing to use a .p8 key stored inside the repository") if key_path.start_with?(repo_root + "/")
  key_path
end

def pt_api_key
  key_path = pt_load_asc_env!
  app_store_connect_api_key(
    key_id: ENV["ASC_KEY_ID"],
    issuer_id: ENV["ASC_ISSUER_ID"],
    key_filepath: key_path,
    duration: 1200,
    in_house: false
  )
end

# Authenticated read-only GET against the App Store Connect API.
def pt_get(path)
  uri = URI("https://api.appstoreconnect.apple.com#{path}")
  req = Net::HTTP::Get.new(uri)
  req["Authorization"] = "Bearer #{Spaceship::ConnectAPI.token.text}"
  res = Net::HTTP.start(uri.host, uri.port, use_ssl: true) { |http| http.request(req) }
  body = JSON.parse(res.body) rescue {}
  unless res.code.to_i == 200
    detail = (body["errors"] || []).map { |e| e["detail"] || e["title"] }.join("; ")
    UI.user_error!("GET #{uri.path} -> HTTP #{res.code} #{detail}")
  end
  body
end

# Authenticated write (PATCH/POST). Callers must run pt_require_confirmation! first.
def pt_write(method, path, body)
  uri = URI("https://api.appstoreconnect.apple.com#{path}")
  req = (method == :patch ? Net::HTTP::Patch : Net::HTTP::Post).new(uri)
  req["Authorization"] = "Bearer #{Spaceship::ConnectAPI.token.text}"
  req["Content-Type"] = "application/json"
  req.body = JSON.dump(body)
  res = Net::HTTP.start(uri.host, uri.port, use_ssl: true) { |http| http.request(req) }
  parsed = JSON.parse(res.body) rescue {}
  unless res.code.to_i.between?(200, 299)
    detail = (parsed["errors"] || []).map { |e| e["detail"] || e["title"] }.join("; ")
    UI.user_error!("#{method.upcase} #{uri.path} -> HTTP #{res.code} #{detail}")
  end
  parsed
end

def pt_editable_version
  pt_get("/v1/apps/#{PT_APP_ID}/appStoreVersions?limit=50")["data"].find do |v|
    %w[PREPARE_FOR_SUBMISSION DEVELOPER_REJECTED REJECTED METADATA_REJECTED INVALID_BINARY].include?(v.dig("attributes", "appStoreState"))
  end
end

def pt_assert_app!
  attrs = pt_get("/v1/apps/#{PT_APP_ID}")["data"]["attributes"]
  UI.user_error!("App #{PT_APP_ID} is #{attrs['bundleId']}, expected #{PT_BUNDLE_ID}") unless attrs["bundleId"] == PT_BUNDLE_ID
  attrs
end

def pt_require_confirmation!(what)
  return if ENV["PT_CONFIRM"] == "yes"
  UI.user_error!("#{what} writes to App Store Connect. Re-run with PT_CONFIRM=yes after explicit approval.")
end

def pt_url_status(url)
  return "not set" if url.to_s.empty?
  uri = URI(url)
  res = Net::HTTP.start(uri.host, uri.port, use_ssl: uri.scheme == "https", open_timeout: 10, read_timeout: 10) do |http|
    http.request(Net::HTTP::Head.new(uri))
  end
  res.code
rescue StandardError => e
  "error (#{e.class})"
end

platform :ios do
  desc "Read-only: verify API access and print versions, builds, TestFlight and review status"
  lane :asc_check do
    pt_api_key
    app = pt_assert_app!
    UI.success("API OK — #{app['name']} (#{app['bundleId']}, App ID #{PT_APP_ID})")

    versions = pt_get("/v1/apps/#{PT_APP_ID}/appStoreVersions?limit=20&include=build")
    builds_by_id = (versions["included"] || []).select { |i| i["type"] == "builds" }.to_h { |b| [b["id"], b] }
    rows = versions["data"].map do |v|
      a = v["attributes"]
      build = builds_by_id[v.dig("relationships", "build", "data", "id")]
      [a["versionString"], a["appStoreState"], a["releaseType"], build ? build.dig("attributes", "version") : "-"]
    end
    puts Terminal::Table.new(title: "App Store versions", headings: %w[Version State Release Build], rows: rows)

    builds = pt_get("/v1/builds?filter[app]=#{PT_APP_ID}&sort=-uploadedDate&limit=20&include=preReleaseVersion,buildBetaDetail")
    inc = (builds["included"] || []).to_h { |i| ["#{i['type']}/#{i['id']}", i] }
    rows = builds["data"].map do |b|
      pre = inc["preReleaseVersions/#{b.dig('relationships', 'preReleaseVersion', 'data', 'id')}"]
      beta = inc["buildBetaDetails/#{b.dig('relationships', 'buildBetaDetail', 'data', 'id')}"]
      [pre&.dig("attributes", "version"), b.dig("attributes", "version"), b.dig("attributes", "processingState"),
       b.dig("attributes", "uploadedDate").to_s[0, 10], b.dig("attributes", "expired"),
       beta&.dig("attributes", "internalBuildState"), beta&.dig("attributes", "externalBuildState")]
    end
    puts Terminal::Table.new(title: "Builds / TestFlight", headings: %w[Version Build Processing Uploaded Expired Internal External], rows: rows)

    groups = pt_get("/v1/apps/#{PT_APP_ID}/betaGroups?limit=50")["data"]
    UI.message("TestFlight groups: #{groups.empty? ? 'none' : groups.map { |g| g.dig('attributes', 'name') }.join(', ')}")

    subs = pt_get("/v1/reviewSubmissions?filter[app]=#{PT_APP_ID}&limit=20&include=items")
    items = (subs["included"] || []).to_h { |i| [i["id"], i.dig("attributes", "state")] }
    rows = subs["data"].map do |s|
      item_states = s.dig("relationships", "items", "data").to_a.map { |i| items[i["id"]] }.compact.join(",")
      [s.dig("attributes", "submittedDate").to_s[0, 16], s.dig("attributes", "state"), item_states]
    end
    puts Terminal::Table.new(title: "Review submissions", headings: %w[Submitted State Items], rows: rows)
    UI.important("Rejection text is not exposed by the API — read it in App Store Connect → App Review.")

    info = pt_get("/v1/apps/#{PT_APP_ID}/appInfos?include=appInfoLocalizations")
    (info["included"] || []).select { |i| i["type"] == "appInfoLocalizations" }.uniq { |l| l.dig("attributes", "privacyPolicyUrl") }.each do |l|
      url = l.dig("attributes", "privacyPolicyUrl")
      UI.message("Privacy Policy URL (#{l.dig('attributes', 'locale')}): #{url} -> #{pt_url_status(url)}")
    end
    latest = versions["data"].first
    if latest
      pt_get("/v1/appStoreVersions/#{latest['id']}/appStoreVersionLocalizations")["data"].each do |l|
        url = l.dig("attributes", "supportUrl")
        UI.message("Support URL (#{latest.dig('attributes', 'versionString')}, #{l.dig('attributes', 'locale')}): #{url} -> #{pt_url_status(url)}")
      end
    end
  end

  desc "Read-only: download App Store metadata into fastlane/metadata (local files only)"
  lane :metadata_pull do |options|
    api_key = pt_api_key
    pt_assert_app!
    require "deliver"
    require "deliver/setup"
    path = options[:metadata_path] || PT_METADATA
    deliver_options = FastlaneCore::Configuration.create(Deliver::Options.available_options, {
      api_key: api_key, app_identifier: PT_BUNDLE_ID, metadata_path: path,
      skip_binary_upload: true, skip_screenshots: true, skip_app_version_update: true, force: true
    })
    Deliver::Runner.new(deliver_options) # authenticates and resolves the app (read-only)
    app = Deliver.cache[:app]
    UI.user_error!("Resolved app #{app.id}, expected #{PT_APP_ID}") unless app.id == PT_APP_ID
    version = app.get_latest_app_store_version(platform: Spaceship::ConnectAPI::Platform::IOS)
    Deliver::Setup.new.generate_metadata_files(app, version, path, deliver_options)
    UI.success("Metadata for #{version.version_string} written to #{path}")
  end

  desc "Local build only: XcodeGen + signed App Store .ipa in build/fastlane (no upload)"
  lane :build do |options|
    pt_api_key
    pt_assert_app!
    sh("cd #{PT_PROJECT_DIR.shellescape} && xcodegen generate")
    build_number = options[:build_number] || pt_next_build_number
    UI.message("Building build number #{build_number}")
    build_app(
      project: PT_PROJECT,
      scheme: PT_SCHEME,
      configuration: "Release",
      export_method: "app-store",
      output_directory: PT_OUTPUT_DIR,
      output_name: "PerfectTap.ipa",
      clean: true,
      xcargs: [
        "CURRENT_PROJECT_VERSION=#{build_number}",
        "DEVELOPMENT_TEAM=#{PT_TEAM_ID}",
        "-allowProvisioningUpdates",
        "-authenticationKeyPath #{File.expand_path(ENV['ASC_KEY_PATH']).shellescape}",
        "-authenticationKeyID #{ENV['ASC_KEY_ID']}",
        "-authenticationKeyIssuerID #{ENV['ASC_ISSUER_ID']}"
      ].join(" "),
      export_options: { signingStyle: "automatic", teamID: PT_TEAM_ID, manageAppVersionAndBuildNumber: false }
    )
    # Verify what was actually built (a hard-coded Info.plist once produced 1.0 (1)).
    ipa = File.join(PT_OUTPUT_DIR, "PerfectTap.ipa")
    info = sh("unzip -p #{ipa.shellescape} 'Payload/*.app/Info.plist' | plutil -convert json -o - -", log: false)
    built = JSON.parse(info)
    expected = pt_project_versions[:version]
    unless built["CFBundleShortVersionString"] == expected && built["CFBundleVersion"] == build_number.to_s
      UI.user_error!("IPA is #{built['CFBundleShortVersionString']} (#{built['CFBundleVersion']}), expected #{expected} (#{build_number})")
    end
    UI.success("IPA #{expected} (#{build_number}) — #{built['CFBundleIdentifier']}")
  end

  desc "Read-only: version/build/privacy/URL/secret checks before a release (fails on blockers)"
  lane :validate_release do
    pt_api_key
    pt_assert_app!
    rows, failures = pt_release_checks
    puts Terminal::Table.new(title: "PerfectTap release checks", headings: ["", "Check", "Result"], rows: rows)
    UI.user_error!("#{failures} release blocker(s)") if failures > 0
    UI.success("No blockers found by automated checks (App Review is still a human decision)")
  end

  desc "Read-only: write build/fastlane/release_report.md (ASC status + release checks)"
  lane :release_report do
    pt_api_key
    pt_assert_app!
    rows, failures = pt_release_checks
    FileUtils.mkdir_p(PT_OUTPUT_DIR)
    path = File.join(PT_OUTPUT_DIR, "release_report.md")
    File.write(path, ["# PerfectTap release readiness — #{Time.now.utc.strftime('%Y-%m-%d %H:%M UTC')}", "",
                      "| | Check | Result |", "|---|---|---|", *rows.map { |r| "| #{r.join(' | ')} |" }, "",
                      "Blockers: #{failures}"].join("\n"))
    UI.success("Wrote #{path}")
  end

  desc "WRITE (PT_CONFIRM=yes): build and upload to TestFlight — internal group only, no review, no external testers"
  lane :beta do |options|
    pt_require_confirmation!("Uploading a TestFlight build")
    if options[:skip_build]
      # Upload the IPA already in build/fastlane, after re-checking what it contains.
      pt_api_key
      pt_assert_app!
      ipa = File.join(PT_OUTPUT_DIR, "PerfectTap.ipa")
      UI.user_error!("No #{ipa} — run `fastlane build` first") unless File.exist?(ipa)
      built = JSON.parse(sh("unzip -p #{ipa.shellescape} 'Payload/*.app/Info.plist' | plutil -convert json -o - -", log: false))
      uploaded = pt_get("/v1/builds?filter[app]=#{PT_APP_ID}&limit=200&fields[builds]=version")["data"].map { |b| b.dig("attributes", "version") }
      UI.user_error!("IPA is #{built['CFBundleShortVersionString']}, project is #{pt_project_versions[:version]}") unless built["CFBundleShortVersionString"] == pt_project_versions[:version]
      UI.user_error!("Build #{built['CFBundleVersion']} was already uploaded") if uploaded.include?(built["CFBundleVersion"])
      UI.message("Uploading existing IPA #{built['CFBundleShortVersionString']} (#{built['CFBundleVersion']})")
    else
      build(options)
    end
    notes = options[:changelog] || ENV["PT_TESTFLIGHT_NOTES"]
    notes ||= File.read(File.expand_path("testflight_notes.txt", __dir__)) if File.exist?(File.expand_path("testflight_notes.txt", __dir__))
    groups = pt_get("/v1/apps/#{PT_APP_ID}/betaGroups?limit=50")["data"]
               .select { |g| g.dig("attributes", "isInternalGroup") }.map { |g| g.dig("attributes", "name") }
    ipa = File.join(PT_OUTPUT_DIR, "PerfectTap.ipa")
    built = JSON.parse(sh("unzip -p #{ipa.shellescape} 'Payload/*.app/Info.plist' | plutil -convert json -o - -", log: false))
    # Upload + wait for processing only. fastlane's distribute step (skipped by
    # skip_submission) is what would set compliance/groups, so those are done below
    # via the API — internal group only, never Beta App Review or external testers.
    upload_to_testflight(
      api_key: lane_context[SharedValues::APP_STORE_CONNECT_API_KEY],
      app_identifier: PT_BUNDLE_ID,
      ipa: ipa,
      distribute_external: false,
      skip_submission: true,
      skip_waiting_for_build_processing: false
    )
    pt_finish_internal_build(built["CFBundleShortVersionString"], built["CFBundleVersion"], notes, groups)
  end

  desc "WRITE (PT_CONFIRM=yes): finish an already-processed build for internal TestFlight, e.g. build:3 (compliance, notes, internal groups)"
  lane :testflight_finish do |options|
    pt_require_confirmation!("Making a build available to internal testers")
    pt_api_key
    pt_assert_app!
    version = options[:version] || pt_project_versions[:version]
    build_number = (options[:build] || pt_project_versions[:build]).to_s
    notes_path = File.expand_path("testflight_notes.txt", __dir__)
    notes = File.exist?(notes_path) ? File.read(notes_path) : nil
    groups = pt_get("/v1/apps/#{PT_APP_ID}/betaGroups?limit=50")["data"]
               .select { |g| g.dig("attributes", "isInternalGroup") }.map { |g| g.dig("attributes", "name") }
    pt_finish_internal_build(version, build_number, notes, groups)
  end

  desc "WRITE (PT_CONFIRM=yes): create the internal TestFlight group if missing (testers are added in App Store Connect)"
  lane :internal_group do
    pt_require_confirmation!("Creating a TestFlight group")
    pt_api_key
    pt_assert_app!
    existing = pt_get("/v1/apps/#{PT_APP_ID}/betaGroups?limit=50")["data"].map { |g| g.dig("attributes", "name") }
    next UI.success("Group '#{PT_INTERNAL_GROUP}' already exists") if existing.include?(PT_INTERNAL_GROUP)
    pt_write(:post, "/v1/betaGroups", {
      data: { type: "betaGroups", attributes: { name: PT_INTERNAL_GROUP, isInternalGroup: true },
              relationships: { app: { data: { type: "apps", id: PT_APP_ID } } } }
    })
    UI.success("Created internal group '#{PT_INTERNAL_GROUP}'")
  end

  desc "WRITE (PT_CONFIRM=yes): rename the editable App Store version, e.g. version:1.1.0 (never the live one)"
  lane :rename_version do |options|
    pt_require_confirmation!("Renaming the App Store version")
    target = options[:version] || pt_project_versions[:version]
    pt_api_key
    pt_assert_app!
    v = pt_editable_version
    UI.user_error!("No editable App Store version") unless v
    current = v.dig("attributes", "versionString")
    next UI.success("Already #{target}") if current == target
    UI.message("Renaming #{current} → #{target}")
    pt_write(:patch, "/v1/appStoreVersions/#{v['id']}", { data: { type: "appStoreVersions", id: v["id"], attributes: { versionString: target } } })
    UI.success("Editable version is now #{pt_get("/v1/appStoreVersions/#{v['id']}").dig('data', 'attributes', 'versionString')}")
  end

  desc "WRITE (PT_CONFIRM=yes): upload fastlane/metadata text only — no binary, no screenshots, no submission"
  lane :metadata_push do
    pt_require_confirmation!("Uploading metadata")
    pt_api_key
    pt_assert_app!
    UI.user_error!("No #{PT_METADATA} — run metadata_pull first") unless Dir.exist?(PT_METADATA)
    upload_to_app_store(
      api_key: lane_context[SharedValues::APP_STORE_CONNECT_API_KEY],
      app_identifier: PT_BUNDLE_ID,
      metadata_path: PT_METADATA,
      skip_binary_upload: true,
      skip_screenshots: true,
      submit_for_review: false,
      automatic_release: false,
      force: true,                      # skip the HTML preview; nothing is submitted
      precheck_include_in_app_purchases: false
    )
  end
end

# Next build number: above every build ever uploaded for this app, and never below the
# value in project.yml (so a local bump is respected).
def pt_next_build_number
  builds = pt_get("/v1/builds?filter[app]=#{PT_APP_ID}&sort=-uploadedDate&limit=200&fields[builds]=version")["data"]
  highest = builds.map { |b| b.dig("attributes", "version").to_i }.max || 0
  [highest + 1, pt_project_versions[:build].to_i].max
end

PT_PROJECT_YML = File.expand_path("../ios/PerfectTap/project.yml", __dir__)
PT_LEGAL_URLS = {
  "Privacy Policy" => "https://oyaholding.github.io/PerfectTap/",
  "Terms" => "https://oyaholding.github.io/PerfectTap/terms.html",
  "Support" => "https://oyaholding.github.io/PerfectTap/support.html",
  "Legacy privacy (live 1.0)" => "https://oyaholding.github.io/perfecttap-pages/",
  "Legacy support (live 1.0)" => "https://oyaholding.github.io/perfecttap-pages/support.html"
}.freeze

def pt_project_versions
  yml = File.read(PT_PROJECT_YML)
  { version: yml[/MARKETING_VERSION:\s*"?([0-9.]+)"?/, 1], build: yml[/CURRENT_PROJECT_VERSION:\s*"?([0-9]+)"?/, 1] }
end

def pt_version_tuple(v)
  v.to_s.split(".").map(&:to_i).fill(0, v.to_s.split(".").size...3)
end

# Read-only release checks. Returns [rows, failures].
def pt_release_checks
  rows = []
  fail = ->(name, detail) { rows << ["❌", name, detail] }
  ok = ->(name, detail) { rows << ["✅", name, detail] }
  warn = ->(name, detail) { rows << ["⚠️", name, detail] }

  local = pt_project_versions
  versions = pt_get("/v1/apps/#{PT_APP_ID}/appStoreVersions?limit=50")["data"]
  live = versions.select { |v| %w[READY_FOR_SALE READY_FOR_DISTRIBUTION].include?(v.dig("attributes", "appStoreState")) }
                 .map { |v| v.dig("attributes", "versionString") }.max_by { |v| pt_version_tuple(v) }
  editable = versions.find { |v| %w[PREPARE_FOR_SUBMISSION DEVELOPER_REJECTED REJECTED METADATA_REJECTED INVALID_BINARY].include?(v.dig("attributes", "appStoreState")) }

  if live.nil? || (pt_version_tuple(local[:version]) <=> pt_version_tuple(live)) == 1
    ok.call("Version", "#{local[:version]} > live #{live || '-'}")
  else
    fail.call("Version", "#{local[:version]} must be greater than live #{live}")
  end
  if editable.nil?
    warn.call("App Store version", "no editable version — create #{local[:version]} in App Store Connect")
  elsif editable.dig("attributes", "versionString") == local[:version]
    ok.call("App Store version", "#{local[:version]} (#{editable.dig('attributes', 'appStoreState')})")
  else
    fail.call("App Store version", "editable version is #{editable.dig('attributes', 'versionString')}, build is #{local[:version]} — run `fastlane rename_version version:#{local[:version]}`")
  end

  builds = pt_get("/v1/builds?filter[app]=#{PT_APP_ID}&limit=200&fields[builds]=version")["data"].map { |b| b.dig("attributes", "version").to_i }
  next_build = pt_next_build_number
  if builds.include?(local[:build].to_i)
    warn.call("Build number", "project.yml #{local[:build]} already uploaded — the build lane will use #{next_build}")
  else
    ok.call("Build number", "#{local[:build]} unused (highest uploaded: #{builds.max || '-'}), next = #{next_build}")
  end

  plist = File.read(PT_PROJECT_YML)
  plist.include?("NSUserTrackingUsageDescription") ? ok.call("ATT usage string", "present") : fail.call("ATT usage string", "NSUserTrackingUsageDescription missing")
  plist.include?("CFBundleShortVersionString: $(MARKETING_VERSION)") ? ok.call("Info.plist version", "bound to MARKETING_VERSION") : fail.call("Info.plist version", "hard-coded")
  manifest = File.read(File.join(PT_PROJECT_DIR, "PrivacyInfo.xcprivacy"))
  manifest[/<key>NSPrivacyTracking<\/key>\s*<true\/>/] ? ok.call("Privacy manifest", "NSPrivacyTracking = true (ATT)") : fail.call("Privacy manifest", "NSPrivacyTracking must be true while AdMob uses IDFA")

  PT_LEGAL_URLS.each do |name, url|
    code = pt_url_status(url)
    code.to_s.start_with?("2", "3") ? ok.call(name, "#{url} → #{code}") : fail.call(name, "#{url} → #{code}")
  end

  repo = File.expand_path("..", __dir__)
  keys = Dir.glob(File.join(repo, "**/*.{p8,p12,mobileprovision}")).reject { |f| f.include?("/vendor/") || f.include?("/build/") }
  keys.empty? ? ok.call("Secrets in repo", "no .p8/.p12/.mobileprovision") : fail.call("Secrets in repo", keys.map { |k| k.sub(repo + '/', '') }.join(", "))

  [rows, rows.count { |r| r[0] == "❌" }]
end

PT_INTERNAL_GROUP = "PerfectTap Internal"

# After processing: export compliance (HTTPS only, exempt), "What to Test", and the
# INTERNAL groups. Verifies the result; never touches external testing.
def pt_finish_internal_build(version, build_number, notes, group_names)
  build = pt_get("/v1/builds?filter[app]=#{PT_APP_ID}&filter[version]=#{build_number}&filter[preReleaseVersion.version]=#{version}")["data"].first
  UI.user_error!("Build #{version} (#{build_number}) not found after processing") unless build
  bid = build["id"]
  # Builds with ITSAppUsesNonExemptEncryption in Info.plist already carry the answer;
  # Apple rejects setting it twice (409), so only set it when it is still missing.
  if build.dig("attributes", "usesNonExemptEncryption").nil?
    pt_write(:patch, "/v1/builds/#{bid}", { data: { type: "builds", id: bid, attributes: { usesNonExemptEncryption: false } } })
  end
  if notes
    loc = pt_get("/v1/builds/#{bid}/betaBuildLocalizations")["data"].find { |l| l.dig("attributes", "locale") == "en-US" }
    if loc
      pt_write(:patch, "/v1/betaBuildLocalizations/#{loc['id']}", { data: { type: "betaBuildLocalizations", id: loc["id"], attributes: { whatsNew: notes.strip } } })
    else
      pt_write(:post, "/v1/betaBuildLocalizations", { data: { type: "betaBuildLocalizations", attributes: { locale: "en-US", whatsNew: notes.strip },
                                                              relationships: { build: { data: { type: "builds", id: bid } } } } })
    end
  end
  internal = pt_get("/v1/apps/#{PT_APP_ID}/betaGroups?limit=50")["data"]
               .select { |g| g.dig("attributes", "isInternalGroup") && group_names.include?(g.dig("attributes", "name")) }
  internal.each { |g| pt_write(:post, "/v1/betaGroups/#{g['id']}/relationships/builds", { data: [{ type: "builds", id: bid }] }) }
  state = pt_get("/v1/builds/#{bid}/buildBetaDetail").dig("data", "attributes", "internalBuildState")
  UI.important("Internal TestFlight state: #{state}")
  UI.success("#{version} (#{build_number}) available to: #{internal.map { |g| g.dig('attributes', 'name') }.join(', ')}") if state == "IN_BETA_TESTING"
end

rules_version = '2';

// PerfectTap Firestore Security Rules
// Deploy with: firebase deploy --only firestore:rules

service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Helper functions ───
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isParticipant(userIds) {
      return isAuthenticated() && request.auth.uid in userIds;
    }

    // ─── User Profiles ───
    match /users/{userId} {
      allow read:   if isOwner(userId);
      allow create: if isOwner(userId);
      allow update: if isOwner(userId);
      allow delete: if isOwner(userId);
    }

    // ─── Player Profiles ───
    match /players/{userId} {
      allow read:   if isAuthenticated();
      allow create: if isOwner(userId);
      allow update: if isOwner(userId);
      allow delete: if isOwner(userId);
    }

    // ─── Leaderboard ───
    match /leaderboard/{mode}/scores/{userId} {
      allow read:   if isAuthenticated();
      allow write:  if isOwner(userId)
                    && request.resource.data.score is int
                    && request.resource.data.score >= 0
                    && request.resource.data.score <= 200000;
    }

    // ─── Duels ───
    match /duels/{duelId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated()
                    && request.resource.data.host_id == request.auth.uid;
      allow update: if isAuthenticated()
                    && (
                      (request.resource.data.guest_id == request.auth.uid)
                      || (resource.data.host_id == request.auth.uid)
                      || (resource.data.guest_id == request.auth.uid)
                    );
    }

    // ─── Friend Requests ───
    match /friend_requests/{requestId} {
      allow read: if isAuthenticated()
                  && (resource.data.from_uid == request.auth.uid
                      || resource.data.to_uid == request.auth.uid);

      allow create: if isAuthenticated()
                    && request.resource.data.from_uid == request.auth.uid
                    && request.resource.data.status == "pending"
                    && request.resource.data.from_uid != request.resource.data.to_uid;

      // Receiver can move pending -> accepted/rejected
      // Sender can move pending -> cancelled
      allow update: if isAuthenticated()
                    && resource.data.status == "pending"
                    && (
                      // Receiver accepts or rejects
                      (resource.data.to_uid == request.auth.uid
                       && request.resource.data.status in ["accepted", "rejected"])
                      ||
                      // Sender cancels
                      (resource.data.from_uid == request.auth.uid
                       && request.resource.data.status == "cancelled")
                    )
                    // Immutable participant fields
                    && request.resource.data.from_uid == resource.data.from_uid
                    && request.resource.data.to_uid == resource.data.to_uid;
    }

    // ─── Friendships (canonical) ───
    match /friendships/{pairId} {
      allow read: if isAuthenticated()
                  && request.auth.uid in resource.data.user_ids;

      allow create: if isAuthenticated()
                    && request.auth.uid in request.resource.data.user_ids
                    && request.resource.data.user_ids is list
                    && request.resource.data.user_ids.size() == 2
                    && request.resource.data.user_ids[0] != request.resource.data.user_ids[1];

      allow update: if isAuthenticated()
                    && request.auth.uid in resource.data.user_ids
                    && request.resource.data.user_ids == resource.data.user_ids;
    }

    // ─── Duel Invitations ───
    match /duel_invitations/{invitationId} {
      allow read: if isAuthenticated()
                  && (resource.data.from_uid == request.auth.uid
                      || resource.data.to_uid == request.auth.uid);

      allow create: if isAuthenticated()
                    && request.resource.data.from_uid == request.auth.uid
                    && request.resource.data.status == "pending"
                    && request.resource.data.from_uid != request.resource.data.to_uid;

      allow update: if isAuthenticated()
                    && (
                      (
                        resource.data.status == "pending"
                        && (
                          // Invitee accepts or rejects
                          (resource.data.to_uid == request.auth.uid
                           && request.resource.data.status in ["accepted", "rejected"])
                          ||
                          // Inviter cancels
                          (resource.data.from_uid == request.auth.uid
                           && request.resource.data.status == "cancelled")
                          ||
                          // Participant marks expired when expires_at has passed
                          (request.auth.uid in [resource.data.from_uid, resource.data.to_uid]
                           && request.resource.data.status == "expired"
                           && resource.data.expires_at <= request.time)
                        )
                      )
                      ||
                      // Inviter can advance accepted invite into in_progress once host launches
                      (
                        resource.data.status == "accepted"
                        && resource.data.from_uid == request.auth.uid
                        && request.resource.data.status == "in_progress"
                      )
                    )
                    // Immutable participant and duel identity fields
                    && request.resource.data.from_uid == resource.data.from_uid
                    && request.resource.data.to_uid == resource.data.to_uid
                    && request.resource.data.duel_id == resource.data.duel_id
                    && request.resource.data.duel_code == resource.data.duel_code
                    && request.resource.data.mode == resource.data.mode;
    }

    // ─── Friend Request State (guard-only) ───
    match /friend_request_state/{pairId} {
      allow read, write: if isAuthenticated()
                         && request.auth.uid in (
                           resource == null
                             ? request.resource.data.user_ids
                             : resource.data.user_ids
                         );
    }

    // ─── Duel Invite State (guard-only) ───
    match /duel_invite_state/{pairId} {
      allow read, write: if isAuthenticated()
                         && request.auth.uid in (
                           resource == null
                             ? request.resource.data.user_ids
                             : resource.data.user_ids
                         );
    }

    // ─── Deny everything else ───
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
